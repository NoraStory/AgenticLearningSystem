# ===== 基础设施 (docker-compose 启动的依赖) =====
POSTGRES_DB=codeforge
POSTGRES_USER=codeforge
POSTGRES_PASSWORD=codeforge
MINIO_ROOT_USER=codeforge
MINIO_ROOT_PASSWORD=codeforge123

# ===== 后端服务 =====
PORT=8080
DATABASE_URL=postgres://codeforge:codeforge@localhost:5432/codeforge?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=codeforge
MINIO_SECRET_KEY=codeforge123
MINIO_USE_SSL=false
MINIO_BUCKET=codeforge
JWT_SECRET=local-development-change-this-secret
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
UPLOAD_DIR=./data/uploads

# ===== 可选：配置后启用真实豆包 Ark 模型；留空时使用本地降级回退 =====
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-1-pro-260628
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

LLM_WIRE_API=responses

# ===== 联网搜索（可选）；未配置 SearXNG 时 SearXNG 搜索会自动降级为 Wikipedia =====
SEARCH_PROVIDER=searxng
SEARCH_BASE_URL=http://localhost:8081
SEARCH_TIMEOUT_SECONDS=8
